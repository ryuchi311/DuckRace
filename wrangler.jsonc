{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "duck-race",
  "main": "worker.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duck-race-db",
      "database_id": "cfa88ac9-cdd5-4f7d-9800-9b70601ecce6"
    }
  ]
}